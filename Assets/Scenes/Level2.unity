  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueUI: {fileID: 1010005291}
  lines:
  - speaker: NEIGHBOUR
    text: Wow! Thank you Gary!
  - speaker: NEIGHBOUR
    text: The robots just, took us here...
  - speaker: NEIGHBOUR
    text: I dont know how well ever repay you
  - speaker: GARY
    text: Oh its not an problem
  - speaker: GARY
    text: But what IS an problem are these robots
  - speaker: GARY
    text: Do you know where their headquarters are?
  - speaker: NEIGHBOUR
    text: Oh yes! its on the 23rd hipsdaadi st.
  - speaker: NEIGHBOUR
    text: The robots didnt do anything bad to us
  - speaker: NEIGHBOUR
    text: They were talking about crime rates and safety
  - speaker: GARY
    text: Well thats sure interesting...
  - speaker: NEIGHBOUR
    text: We will lay low for an bit and head home, bye!
  delayBeforeDialogue: 1
